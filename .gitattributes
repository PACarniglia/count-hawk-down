# Normalize EOL for text files and keep LF across all platforms.
* text=auto eol=lf

# Common Godot text assets (merge-friendly)
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf

# Common Godot binary assets
*.res binary
*.scn binary
*.import binary

