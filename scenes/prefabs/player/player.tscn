[sub_resource type="Shader" id="Shader_hero_invert"]
code = "shader_type canvas_item;

uniform bool invert_enabled = false;

void fragment() {
	vec4 tex = texture(TEXTURE, UV);
	if (invert_enabled) {
		tex.rgb = vec3(1.0) - tex.rgb;
	}
	COLOR = tex * COLOR;
}
"

